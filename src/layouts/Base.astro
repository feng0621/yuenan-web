---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, languageTag, locales, switchLocalePath, type Locale } from '../i18n';
import '@fontsource-variable/noto-sans';
import '../styles/global.css';

interface Props { locale: Locale; title?: string; description?: string; header?: 'overlay' | 'solid' }
const { locale, title, description, header = 'overlay' } = Astro.props;
const site = getSite(locale);
const fullTitle = title ? `${title} - ${site.company.name}` : site.ui.defaultTitle;
const desc = description ?? site.ui.defaultDescription;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={languageTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#c49e5f" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    {locales.map((item) => <link rel="alternate" hreflang={languageTag(item)} href={switchLocalePath(path, item)} />)}
    <link rel="alternate" hreflang="x-default" href={switchLocalePath(path, 'vi')} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // Keep content visible if the motion script fails to load.
        setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('motion'); }, 5000);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skip}</a>
    <Header locale={locale} variant={header} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
