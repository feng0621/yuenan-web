---
import type { Locale } from '../i18n';
interface Props { name: string; role: string; photo: string; locale: Locale }
const { name, role, photo, locale } = Astro.props;
const alt = locale === 'zh' ? `${name}，${role}` : `${name}, ${role}`;
---
<article class="team-card" data-card data-team-card>
  <div class="team-card__photo">
    <img src={`/images/team/${photo}.webp`} alt={alt} loading="lazy" />
  </div>
  <div class="team-card__plate">
    <h3>{name}</h3>
    <p>{role}</p>
  </div>
</article>
